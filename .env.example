# Copia este archivo como ".env" (en la misma carpeta) para cambiar la configuración de Docker.
# Todo es opcional: sin este archivo la aplicación funciona con los valores por defecto.

# Contraseña de la base de datos (solo letras y números). Cámbiala ANTES del primer inicio.
DB_PASSWORD=inventory

# Puerto en el que se abre la aplicación: http://localhost:8000
APP_PORT=8000

# Zona horaria del negocio
TZ=America/Caracas

# Clave para firmar las sesiones. Si se deja vacía, se genera una automáticamente.
SECRET_KEY=
